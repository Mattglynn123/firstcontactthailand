---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  image: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  topActionLabel?: string;
  topActionHref?: string;
}

const {
  eyebrow,
  title,
  text,
  image,
  primaryLabel = 'Contact First Contact',
  primaryHref = '/contact-link/',
  secondaryLabel,
  secondaryHref,
  topActionLabel,
  topActionHref,
} = Astro.props;
---

<section class="page-hero" style={`--page-hero-image: url('${image}')`}>
  <div class="page-hero__inner">
    {topActionLabel && topActionHref && (
      <div class="page-hero__top-action">
        <a class="page-cta archive-top-action__cta" href={topActionHref}>{topActionLabel}</a>
      </div>
    )}
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-hero__text">{text}</p>
    <div class="page-hero__actions">
      <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>
      {secondaryLabel && secondaryHref && <a class="button button--light" href={secondaryHref}>{secondaryLabel}</a>}
    </div>
  </div>
</section>

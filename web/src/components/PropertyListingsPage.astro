---
import type { PropertyArea } from '../data/property-areas';
import { propertyAreas } from '../data/property-areas';

interface Props { area: PropertyArea; }
const { area } = Astro.props;
---

<section
  class="property-catalogue property-catalogue--live"
  data-property-catalogue
  data-area={area.slug}
  data-area-name={area.name}
  data-fallback-image={area.image}
  data-listings-path={`/data/property-listings/${area.slug}.json`}
>
  <div class="property-catalogue__inner">
    <div class="property-sales-topbar">
      <a href="/">Return to Homepage</a>
    </div>

    <h1>{area.name}</h1>
    <p class="property-sales-intro">{area.intro}</p>

    <form class="property-filters property-filters--live" data-property-filters>
      <select name="location" aria-label="Area"><option value="">All areas</option></select>
      <select name="minPrice" aria-label="Minimum price">
        <option value="">Min price</option>
        <option value="1000000">THB 1m</option>
        <option value="2000000">THB 2m</option>
        <option value="3000000">THB 3m</option>
        <option value="4000000">THB 4m</option>
        <option value="5000000">THB 5m</option>
        <option value="6000000">THB 6m</option>
        <option value="7000000">THB 7m</option>
        <option value="8000000">THB 8m</option>
        <option value="9000000">THB 9m</option>
        <option value="10000000">THB 10m</option>
        <option value="11000000">THB 11m</option>
        <option value="12000000">THB 12m</option>
        <option value="13000000">THB 13m</option>
        <option value="14000000">THB 14m</option>
        <option value="15000000">THB 15m</option>
        <option value="16000000">THB 16m</option>
        <option value="17000000">THB 17m</option>
        <option value="18000000">THB 18m</option>
        <option value="19000000">THB 19m</option>
        <option value="20000000">THB 20m</option>
        <option value="25000000">THB 25m</option>
        <option value="30000000">THB 30m</option>
        <option value="40000000">THB 40m</option>
        <option value="50000000">THB 50m</option>
        <option value="75000000">THB 75m</option>
        <option value="100000000">THB 100m</option>
        <option value="150000000">THB 150m</option>
        <option value="200000000">THB 200m</option>
      </select>
      <select name="maxPrice" aria-label="Maximum price">
        <option value="">Max price</option>
        <option value="1000000">THB 1m</option>
        <option value="2000000">THB 2m</option>
        <option value="3000000">THB 3m</option>
        <option value="4000000">THB 4m</option>
        <option value="5000000">THB 5m</option>
        <option value="6000000">THB 6m</option>
        <option value="7000000">THB 7m</option>
        <option value="8000000">THB 8m</option>
        <option value="9000000">THB 9m</option>
        <option value="10000000">THB 10m</option>
        <option value="11000000">THB 11m</option>
        <option value="12000000">THB 12m</option>
        <option value="13000000">THB 13m</option>
        <option value="14000000">THB 14m</option>
        <option value="15000000">THB 15m</option>
        <option value="16000000">THB 16m</option>
        <option value="17000000">THB 17m</option>
        <option value="18000000">THB 18m</option>
        <option value="19000000">THB 19m</option>
        <option value="20000000">THB 20m</option>
        <option value="25000000">THB 25m</option>
        <option value="30000000">THB 30m</option>
        <option value="40000000">THB 40m</option>
        <option value="50000000">THB 50m</option>
        <option value="75000000">THB 75m</option>
        <option value="100000000">THB 100m</option>
        <option value="150000000">THB 150m</option>
        <option value="200000000">THB 200m</option>
      </select>
      <select name="bedrooms" aria-label="Bedrooms">
        <option value="">Beds</option>
        <option value="1">1+</option>
        <option value="2">2+</option>
        <option value="3">3+</option>
        <option value="4">4+</option>
        <option value="5">5+</option>
      </select>
      <select name="bathrooms" aria-label="Bathrooms">
        <option value="">Baths</option>
        <option value="1">1+</option>
        <option value="2">2+</option>
        <option value="3">3+</option>
        <option value="4">4+</option>
        <option value="5">5+</option>
      </select>
      <button type="submit">Search</button>
      <button type="button" data-property-refresh>Refresh listings</button>
    </form>

    <div class="property-results" data-property-results>
      <p class="property-results__loading">Loading current property listings...</p>
    </div>
    <button class="property-load-more" type="button" data-property-more hidden>Show more properties</button>

    <nav class="property-sales-bottom-nav" aria-label="Property sales areas">
      <a href="/property-sales/">Property Sales</a>
      {propertyAreas.map((item) => <a href={`/property-sales/${item.slug}/`}>{item.name}</a>)}
    </nav>

    <div class="property-catalogue__contact">
      <h2>Looking for something specific?</h2>
      <p>Tell us your preferred location, property type and budget. We will connect you with the relevant local property contact.</p>
      <a class="page-cta" href={`/contact-link/?topic=${encodeURIComponent(`${area.name} property sales`)}`}>Ask about {area.name} property sales</a>
    </div>
  </div>

  <dialog class="property-gallery" data-property-gallery>
    <div class="property-gallery__top">
      <p data-gallery-title>Property photos</p>
      <button type="button" data-gallery-close aria-label="Close photo gallery">Close</button>
    </div>
    <div class="property-gallery__grid" data-gallery-grid></div>
  </dialog>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-property-catalogue]');
    if (!root) return;

    const form = root.querySelector('[data-property-filters]');
    const results = root.querySelector('[data-property-results]');
    const count = root.querySelector('[data-property-count]');
    const sort = root.querySelector('[data-property-sort]');
    const more = root.querySelector('[data-property-more]');
    const refresh = root.querySelector('[data-property-refresh]');
    const locationSelect = form.elements.location;
    const gallery = root.querySelector('[data-property-gallery]');
    const galleryGrid = root.querySelector('[data-gallery-grid]');
    const galleryTitle = root.querySelector('[data-gallery-title]');
    const areaSlug = root.dataset.area;
    const areaName = root.dataset.areaName;
    const fallbackImage = root.dataset.fallbackImage || `/assets/fct/property-areas/${areaSlug}.jpg`;
    let allListings = [];
    let filteredListings = [];
    let visibleCount = 24;

    const escapeHtml = (value) => String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

    const sourceProviderName = ['La', 'zudi'].join('');
    const samuiProviderName = ['Zee', 'mui'].join('');
    const westernProviderName = ['re', 'max'].join('');
    const suppressedPortalName = ['top', 'properties'].join('');
    const contactLinePattern = /\b(?:Contact(?: us| Pim)?|Email|Line(?: ID)?|Phone|Tel|View More Properties|Website|WeChat(?: ID)?|WhatsApp(?:\s*\/\s*Line)?)[^.!?]*(?:[.!?]|$)/gi;
    const clean = (value) => String(value ?? '')
      .replace(/<[^>]*>/g, ' ')
      .replace(/\bRE\s*\/?\s*MAX\b/gi, '')
      .replace(/\bRE\s+MAX\b/gi, '')
      .replace(new RegExp(`\\b${westernProviderName}[A-Za-z0-9_#-]*\\b`, 'gi'), '')
      .replace(new RegExp(`[A-Za-z0-9_.-]*${westernProviderName}[A-Za-z0-9_.-]*`, 'gi'), '')
      .replace(/\bTop Properties\b/gi, '')
      .replace(new RegExp(`\\b${suppressedPortalName}\\b`, 'gi'), '')
      .replace(/\bParadise Properties(?: Krabi)?\b/gi, '')
      .replace(/\bKate Property Krabi\b/gi, '')
      .replace(new RegExp(`\\b${sourceProviderName}\\b`, 'gi'), '')
      .replace(new RegExp(`\\b${samuiProviderName}\\b`, 'gi'), '')
      .replace(/\bLAZ\d+\b/gi, '')
      .replace(contactLinePattern, ' ')
      .replace(/[A-Z0-9._%+-]+@\S+/gi, ' ')
      .replace(/https?:\/\/\S+|www\.\S+/gi, ' ')
      .replace(/#[\p{L}\p{N}_-]+/gu, ' ')
      .replace(/\s+/g, ' ')
      .trim();
    const isExternalImage = (src) => /^https?:\/\//i.test(String(src || ''));
    const imageClass = (src) => isExternalImage(src) ? 'property-image--sanitized' : '';

    const listingTime = (listing) => Date.parse(listing.updatedAt || listing.createdAt || '') || 0;
    const listingCreatedTime = (listing) => Date.parse(listing.createdAt || listing.updatedAt || '') || 0;
    const isNewListing = (listing) => {
      const createdTime = listingCreatedTime(listing);
      return Boolean(listing.newListing && createdTime && Date.now() - createdTime <= 3 * 24 * 60 * 60 * 1000);
    };
    const summary = (value) => {
      const text = clean(value);
      return text.length > 170 ? `${text.slice(0, 167)}...` : text;
    };
    const formatPrice = (listing) => listing.price
      ? `THB ${Number(listing.price).toLocaleString('en-US')}`
      : 'Price on application';

    const sortListings = (listings) => {
      const selected = sort?.value || 'recommended';
      return [...listings].sort((a, b) => {
        if (selected === 'price-asc') return (a.price || Number.MAX_SAFE_INTEGER) - (b.price || Number.MAX_SAFE_INTEGER);
        if (selected === 'price-desc') return (b.price || 0) - (a.price || 0);
        if (selected === 'newest') return listingTime(b) - listingTime(a);
        if (isNewListing(a) !== isNewListing(b)) return isNewListing(a) ? -1 : 1;
        if (listingTime(a) !== listingTime(b)) return listingTime(b) - listingTime(a);
        if (a.featured !== b.featured) return a.featured ? -1 : 1;
        if (Boolean(a.price) !== Boolean(b.price)) return a.price ? -1 : 1;
        if (a.price && b.price && a.price !== b.price) return a.price - b.price;
        return String(a.title || '').localeCompare(String(b.title || ''));
      });
    };

    const cardHtml = (listing, index) => {
      const image = listing.images?.[0] || fallbackImage;
      const full = clean(listing.description) || `Current property listing for sale in ${areaName}.`;
      const short = summary(full);
      const facts = [
        listing.bedrooms ? `${listing.bedrooms} bed${listing.bedrooms === 1 ? '' : 's'}` : '',
        listing.bathrooms ? `${listing.bathrooms} bath${listing.bathrooms === 1 ? '' : 's'}` : '',
      ].filter(Boolean);
      const badges = [
        isNewListing(listing) ? '<span class="property-card__new">New Listing</span>' : '',
        listing.featured ? '<span>Featured</span>' : '',
      ].join('');
      const title = clean(listing.title) || `${areaName} Property For Sale`;
      return `<article class="property-card" data-location="${escapeHtml(clean(listing.location))}" data-price="${Number(listing.price) || 0}" data-bedrooms="${Number(listing.bedrooms) || 0}" data-bathrooms="${Number(listing.bathrooms) || 0}">
        <button class="property-card__media" type="button" data-gallery-open="${index}" aria-label="View photos of ${escapeHtml(title)}">
          <img class="${imageClass(image)}" src="${escapeHtml(image)}" alt="${escapeHtml(title)}" loading="lazy" decoding="async">
          ${badges ? `<span class="property-card__badges">${badges}</span>` : ''}
          ${listing.images?.length > 1 ? `<span class="property-card__photos">${listing.images.length} photos</span>` : ''}
        </button>
        <div class="property-card__body">
          <h3>${escapeHtml(title)}</h3>
          <div class="property-card__meta">
            <span>${escapeHtml(formatPrice(listing))}</span>
            <span>${escapeHtml(clean(listing.location) || areaName)}</span>
            ${facts.map((fact) => `<span>${escapeHtml(fact)}</span>`).join('')}
          </div>
          <p class="property-card__description property-card__description--short">${escapeHtml(short)}</p>
          <p class="property-card__description property-card__description--full" hidden>${escapeHtml(full)}</p>
          ${full.length > short.length ? '<button class="property-card__read-more" type="button" data-description-toggle>Read full description</button>' : ''}
          <div class="property-card__actions">
            <button type="button" data-gallery-open="${index}">View photos</button>
            <a href="/contact-link/?property=${encodeURIComponent(title || listing.id)}">Enquire</a>
          </div>
        </div>
      </article>`;
    };

    const populateAreas = () => {
      const current = locationSelect.value;
      const locations = [...new Set(allListings.map((listing) => String(listing.location || '').split(',')[0].trim()).filter(Boolean))].sort();
      locationSelect.innerHTML = '<option value="">All areas</option>' + locations.map((location) => `<option value="${escapeHtml(location)}">${escapeHtml(location)}</option>`).join('');
      locationSelect.value = current;
    };

    const render = () => {
      const sorted = sortListings(filteredListings);
      const visible = sorted.slice(0, visibleCount);
      if (count) count.textContent = `${filteredListings.length.toLocaleString()} ${filteredListings.length === 1 ? 'property' : 'properties'} found`;
      results.innerHTML = visible.length
        ? visible.map(cardHtml).join('')
        : '<article class="property-card property-card--message"><div class="property-card__body"><h3>No properties match these filters</h3><p>Clear the filters or contact us with your requirements.</p></div></article>';
      more.hidden = visible.length >= sorted.length;
      results.querySelectorAll('.property-card__media img').forEach((image) => {
        const useFallback = () => {
          if (fallbackImage && image.getAttribute('src') !== fallbackImage) image.src = fallbackImage;
        };
        image.addEventListener('error', useFallback);
        if (image.complete && image.naturalWidth === 0) useFallback();
      });
    };

    const applyFilters = () => {
      const data = new FormData(form);
      const location = String(data.get('location') || '').toLowerCase();
      const minPrice = Number(data.get('minPrice') || 0);
      const maxPrice = Number(data.get('maxPrice') || 0);
      const bedrooms = Number(data.get('bedrooms') || 0);
      const bathrooms = Number(data.get('bathrooms') || 0);
      filteredListings = allListings.filter((listing) => {
        const cardLocation = String(listing.location || '').split(',')[0].trim().toLowerCase();
        return (!location || cardLocation === location)
          && (!minPrice || listing.price >= minPrice)
          && (!maxPrice || (listing.price > 0 && listing.price <= maxPrice))
          && (!bedrooms || listing.bedrooms >= bedrooms)
          && (!bathrooms || listing.bathrooms >= bathrooms);
      });
      visibleCount = 24;
      render();
    };

    const fetchSnapshot = async () => {
      const response = await fetch(root.dataset.listingsPath);
      if (!response.ok) throw new Error(`Snapshot HTTP ${response.status}`);
      return (await response.json()).listings || [];
    };

    const loadListings = async () => {
      if (count) count.textContent = `Loading ${areaName} properties...`;
      results.innerHTML = '<p class="property-results__loading">Loading current property listings...</p>';
      try {
        allListings = await fetchSnapshot();
        populateAreas();
        filteredListings = allListings;
        visibleCount = 24;
        applyFilters();
      } catch {
        if (count) count.textContent = 'Listings temporarily unavailable';
        results.innerHTML = `<article class="property-card property-card--message"><div class="property-card__body"><h3>Listing feed not loaded</h3><p>The page is built, but the listing feed could not be reached from this browser session.</p><a href="/contact-link/?topic=${encodeURIComponent(`${areaName} property sales`)}">Enquire</a></div></article>`;
      }
    };

    form.addEventListener('submit', (event) => { event.preventDefault(); applyFilters(); });
    form.addEventListener('input', applyFilters);
    form.addEventListener('change', applyFilters);
    sort?.addEventListener('change', render);
    more.addEventListener('click', () => { visibleCount += 24; render(); });
    refresh.addEventListener('click', loadListings);
    gallery.querySelector('[data-gallery-close]').addEventListener('click', () => gallery.close());
    gallery.addEventListener('click', (event) => { if (event.target === gallery) gallery.close(); });
    results.addEventListener('click', (event) => {
      const toggle = event.target.closest('[data-description-toggle]');
      if (toggle) {
        const body = toggle.closest('.property-card__body');
        const shortText = body.querySelector('.property-card__description--short');
        const fullText = body.querySelector('.property-card__description--full');
        const open = toggle.getAttribute('data-open') === 'true';
        shortText.hidden = !open;
        fullText.hidden = open;
        toggle.setAttribute('data-open', String(!open));
        toggle.textContent = open ? 'Read full description' : 'Show less';
        return;
      }
      const galleryButton = event.target.closest('[data-gallery-open]');
      if (galleryButton) {
        const listing = sortListings(filteredListings).slice(0, visibleCount)[Number(galleryButton.dataset.galleryOpen)];
        const images = listing?.images?.length ? listing.images : [fallbackImage];
        const title = clean(listing?.title) || 'Property photos';
        galleryTitle.textContent = title;
        galleryGrid.innerHTML = images.map((image, index) => `<span class="property-gallery__image-frame"><img class="${imageClass(image)}" src="${escapeHtml(image)}" alt="${escapeHtml(title)} ${index + 1}" loading="eager" decoding="async"></span>`).join('');
        gallery.showModal();
      }
    });

    loadListings();
  })();
</script>

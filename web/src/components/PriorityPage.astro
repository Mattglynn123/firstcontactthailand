---
import type { PriorityPage as Page } from '../data/site';
import ServiceCard from './ServiceCard.astro';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const primaryCtaClass = `page-cta${page.ctaImage ? ' page-cta--image' : ''}`;
---

<section class={`reference-page reference-page--${page.slug}`}>
  <div class="reference-page__inner">
    {page.slug === 'local-business-network' && (
      <figure class="reference-page__feature-image">
        <img src={page.heroImage} alt="First Contact Thailand business community" width="1280" height="720" loading="eager" decoding="async" />
      </figure>
    )}
    <header class="reference-page__heading">
      <h1>{page.title}</h1>
      <p>{page.heroText}</p>
    </header>
    <div class={`service-grid service-grid--${page.gridColumns ?? 3}`}>
      {page.cards.map((card) => <ServiceCard card={card} />)}
    </div>
    {(page.ctaLabel && page.ctaHref) && (
      <div class="reference-page__actions">
        <a class={primaryCtaClass} href={page.ctaHref}>{page.ctaLabel}</a>
        {page.secondaryLabel && page.secondaryHref && <a class="page-cta page-cta--image" href={page.secondaryHref}>{page.secondaryLabel}</a>}
      </div>
    )}
    {(!page.ctaLabel && page.secondaryLabel && page.secondaryHref) && (
      <div class="reference-page__actions">
        <a class="page-cta page-cta--image" href={page.secondaryHref}>{page.secondaryLabel}</a>
      </div>
    )}
  </div>
</section>

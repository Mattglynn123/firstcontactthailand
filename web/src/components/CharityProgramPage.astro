---
import type { CharityProgram } from '../data/charities';

interface Props {
  program: CharityProgram & { location: string; regionSlug: string; sourceName: string; sourceUrl: string };
}
const { program } = Astro.props;

const programWords = `${program.title} ${program.text}`.toLowerCase();
const has = (...words: string[]) => words.some((word) => programWords.includes(word));
const focus = (() => {
  if (has('water safety', 'drowning', 'swim', 'lifesaving', 'surf')) return {
    type: 'waterSafety',
    need: `The program helps children, families, students, and community volunteers in ${program.location} build confidence around water, learn safer habits, and reduce preventable accidents.`,
    support: 'Support can help with qualified instructors, rescue and training equipment, pool or beach sessions, transport for children, safety materials, volunteer coordination, and community outreach.',
  };
  if (has('drinking water', 'sanitation', 'water and sanitation', 'world water')) return {
    type: 'drinkingWater',
    need: `The program focuses on practical access to safer water, better hygiene, and healthier daily routines for schools, families, and community groups connected with ${program.location}.`,
    support: 'Support can help fund filtration equipment, storage, sanitation improvements, school water stations, hygiene education, maintenance, transport, and local follow-up.',
  };
  if (has('eye', 'vision', 'glasses', 'spectacles')) return {
    type: 'eyeCare',
    need: `The program helps children whose learning, confidence, and daily life can be affected when eyesight problems are not identified or corrected early.`,
    support: 'Support can help with screening days, eye tests, prescription glasses, transport, school coordination, and follow-up checks so children can keep learning comfortably.',
  };
  if (has('autism', 'child protection', 'children of the forest', 'low income', 'food', 'poor')) return {
    type: 'vulnerableFamilies',
    need: `The program supports vulnerable children, families, carers, or low-income communities who need practical help, safer support networks, and reliable local follow-through.`,
    support: 'Support can help with food, school supplies, transport, family support, activities, learning materials, care packages, outreach visits, and the running costs that keep help consistent.',
  };
  if (has('nursing', 'scholar', 'ged', 'school', 'library', 'education', 'literacy', 'youth', 'student')) return {
    type: 'education',
    need: `The program focuses on education, confidence, and opportunity for students and young people who benefit from extra support beyond the normal school day.`,
    support: 'Support can help with scholarships, books, learning materials, uniforms, transport, mentoring, classroom resources, training sessions, and practical pathways for students.',
  };
  if (has('aed', 'defib', 'police', 'rescue', 'covid', 'ultrasound', 'health', 'hospital', 'clinic', 'pads')) return {
    type: 'healthResponse',
    need: `The program strengthens local health and emergency response so people in ${program.location} can get faster, more practical help when it matters.`,
    support: 'Support can help with medical equipment, replacement supplies, AED pads, training sessions, response coordination, awareness materials, and practical support for local teams.',
  };
  if (has('peace', 'culture', 'promoting peace')) return {
    type: 'peace',
    need: `The program helps children and communities learn peaceful communication, confidence, cooperation, and positive ways to handle conflict.`,
    support: 'Support can help with workshops, art materials, school sessions, youth activities, facilitation, awards, scholarships, and community events that keep the message visible.',
  };
  if (has('environment', 'roads', 'safe roads', 'reusable', 'waste')) return {
    type: 'communitySafety',
    need: `The program improves everyday community safety and living conditions through practical local projects that make public spaces easier and safer to use.`,
    support: 'Support can help with equipment, signage, education materials, infrastructure, community clean-up or safety work, school coordination, and local implementation costs.',
  };
  if (has('football', 'golf', 'entrepreneurs', 'fair', 'shop local', 'social responsibility')) return {
    type: 'communityParticipation',
    need: `The program brings local people together through sport, enterprise, service, and community participation so young people and local groups can build confidence and connection.`,
    support: 'Support can help with event materials, venue costs, transport, coaching, mentoring, prizes, outreach, volunteer support, and practical expenses for community participation.',
  };
  return {
    type: 'communitySupport',
    need: `The program focuses on practical community support in ${program.location}, with local partners helping turn goodwill into useful action for people who need it.`,
    support: 'Support can help with supplies, transport, training, outreach, equipment, volunteer coordination, awareness, and the day-to-day costs that keep local charity programs moving.',
  };
})();
const detailImageSets = {
  waterSafety: [
    program.image,
    '/assets/fct/charity/phuket/save-a-child-swim-program.png',
    '/assets/fct/charity/koh-samui/swim-4-life.jpeg',
    '/assets/fct/beach-1-scaled.jpg',
  ],
  drinkingWater: [
    program.image,
    '/assets/fct/drinking-scaled.jpg',
    '/assets/fct/charity/bangkok/clean-drinking-water-systems.jpg',
    '/assets/fct/charity/chiang-mai/water-and-sanitation-project.jpg',
  ],
  eyeCare: [
    program.image,
    '/assets/fct/charity/hua-hin/eyeglasses-for-children.jpg',
    '/assets/fct/chiang-mai-vision-screening.jpg',
    '/assets/fct/charity/chiang-mai/school-vision-screening.jpg',
    '/assets/fct/contact-community.jpg',
  ],
  vulnerableFamilies: [
    program.image,
    '/assets/fct/charity/hua-hin/children-of-the-forest.jpg',
    '/assets/fct/charity/chiang-mai/free-food-for-the-poor-initiative.jpg',
    '/assets/fct/charity/koh-samui/support-4-autism.jpg',
  ],
  education: [
    program.image,
    '/assets/fct/charity/chiang-mai/b-e-a-m-ged-program.jpg',
    '/assets/fct/charity/hua-hin/library-books-for-local-schools.jpg',
    '/assets/fct/charity/phuket/tsunami-scholarship-program.jpg',
  ],
  healthResponse: [
    program.image,
    '/assets/fct/charity/phuket/aed-pads.png',
    '/assets/fct/charity/hua-hin/police-help-save-lives.jpg',
    '/assets/fct/charity/hua-hin/ultrasound-technology-project.jpg',
  ],
  peace: [
    program.image,
    '/assets/fct/charity/pattaya/promoting-peace.webp',
    '/assets/fct/charity/chiang-mai/cultivating-a-peace-culture-in-school.jpg',
    '/assets/fct/hero-community.jpg',
  ],
  communitySafety: [
    program.image,
    '/assets/fct/charity/phuket/safe-roads-project.png',
    '/assets/fct/charity/bangkok/low-income-communities.jpg',
    '/assets/fct/hero-community.jpg',
  ],
  communityParticipation: [
    program.image,
    '/assets/fct/charity/bangkok/youth.jpg',
    '/assets/fct/charity/hua-hin/hua-hin-youth-football-championship-for-literacy.jpg',
    '/assets/fct/charity/pattaya/shop-local-too.webp',
    '/assets/fct/hero-community.jpg',
  ],
  communitySupport: [
    program.image,
    '/assets/fct/hero-community.jpg',
    '/assets/fct/contact-community.jpg',
    '/assets/fct/charity/bangkok/youth.jpg',
  ],
};
const defaultDetailImages = Array.from(new Set(detailImageSets[focus.type] ?? detailImageSets.communitySupport));
const details = program.details ?? [
  {
    title: 'Program Overview',
    text: `${program.text} This internal page summarises the purpose, local need, and practical support route from the ${program.sourceName} program information so supporters can understand the project before making an enquiry.`,
    image: defaultDetailImages[0],
  },
  {
    title: 'Who It Helps',
    text: `${focus.need} The emphasis is on practical local benefit rather than sending visitors away to an external site before they know what the program is for.`,
    image: defaultDetailImages[1] ?? defaultDetailImages[0],
  },
  {
    title: 'How Support Helps',
    text: `${focus.support} First Contact can collect the enquiry, preferred location, and type of help, then route it toward the right local charity contact.`,
    image: defaultDetailImages[2] ?? defaultDetailImages[0],
  },
  {
    title: 'Get Involved',
    text: `First Contact can collect your question, preferred location, and type of support, then connect you with the right route for this ${program.sourceName} program.`,
    image: defaultDetailImages[3] ?? defaultDetailImages[0],
  },
];
---

<article class="charity-summary">
  <a class="page-cta charity-summary__back" href={`/${program.regionSlug}/`}>Back to {program.location} charity programs</a>
  <header class="charity-summary__heading">
    <p class="section-kicker">{program.location} charity program</p>
    <h1>{program.title}</h1>
    <p>{program.text}</p>
  </header>
  <div class="charity-detail-grid">
    {details.map((detail) => (
      <section class="charity-detail-card">
        <img src={detail.image ?? program.image} alt={detail.title} loading="eager" decoding="async" onerror="this.onerror=null;this.src='/assets/fct/hero-community.jpg';" />
        <div>
          <h2>{detail.title}</h2>
          <p>{detail.text}</p>
        </div>
      </section>
    ))}
  </div>
  <div class="charity-summary__actions">
    <p>This is a {program.sourceName} program</p>
    <a class="page-cta" href={`/contact-link/?topic=${encodeURIComponent(program.title)}`}>Ask how you can support this program</a>
  </div>
</article>

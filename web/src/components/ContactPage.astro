---
import Layout from '../layouts/Layout.astro';
import { contact } from '../data/site';

const pageTitle = 'Contact Us';
const description = 'Contact First Contact Thailand for trusted local introductions, events, tours, property, hire and deals.';
---

<Layout title={`${pageTitle} | First Contact Thailand`} description={description} image="/assets/fct/contact-community.jpg">
  <section class="section contact-section contact-section--plain">
    <div class="section__inner contact-layout">
      <div class="contact-copy">
        <h1>{pageTitle}</h1>
        <p>Use this form for a business introduction, event, tour, property enquiry, hire request or local recommendation.</p>
        <div class="contact-direct">
          <a href={contact.whatsapp} target="_blank" rel="noreferrer">
            <span>WhatsApp</span>
            <strong>{contact.phoneDisplay}</strong>
          </a>
        </div>
      </div>

      <form class="contact-form" data-contact-form>
        <div class="form-row">
          <label>
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>
        <label>
          <span>What do you need help with?</span>
          <select name="topic">
            <option>Business introduction</option>
            <option>Community event</option>
            <option>Tour or local experience</option>
            <option>Property</option>
            <option>Hire or transport</option>
            <option>Local deal or recommendation</option>
            <option>Something else</option>
          </select>
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" rows="7" required></textarea>
        </label>
        <button class="page-cta page-cta--image contact-form__submit" type="submit">Submit</button>
        <p class="form-note">All information is kept in the strictest of confidentiality.</p>
      </form>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-contact-form]');
    if (!form) return;

    const params = new URLSearchParams(window.location.search);
    const titleCase = (value) => value
      .replace(/[-_]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      .replace(/\b\w/g, (letter) => letter.toUpperCase())
      .replace(/\b(Vip|Ai)\b/g, (word) => word.toUpperCase());
    const requestedTopic = params.get('topic')
      || params.get('property')
      || params.get('fct_event')
      || params.get('fct_service')
      || params.get('fct_charity');
    if (requestedTopic) {
      const select = form.querySelector('select[name="topic"]');
      const topicLabel = titleCase(requestedTopic);
      const customOption = document.createElement('option');
      customOption.value = topicLabel;
      customOption.textContent = topicLabel;
      customOption.selected = true;
      select?.appendChild(customOption);
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const subject = `First Contact enquiry: ${data.get('topic')}`;
      const body = [
        `Name: ${data.get('name')}`,
        `Email: ${data.get('email')}`,
        `Topic: ${data.get('topic')}`,
        '',
        String(data.get('message') ?? ''),
      ].join('\n');
      window.location.href = `mailto:info@firstcontactthailand.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  })();
</script>

---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import { contact } from '../data/site';

const pageTitle = 'Contact First Contact Thailand';
const description = 'Contact First Contact Thailand for trusted local introductions, events, tours, property, hire and deals.';
---

<Layout title={`${pageTitle} | First Contact Thailand`} description={description} image="/assets/fct/contact-community.jpg">
  <PageHero
    eyebrow="Get connected"
    title={pageTitle}
    text="Tell us what you need and we will help connect you with trusted local partners across the network."
    image="/assets/fct/contact-community.jpg"
    primaryLabel="Message on WhatsApp"
    primaryHref={contact.whatsapp}
    secondaryLabel="Open Facebook Community"
    secondaryHref={contact.facebook}
  />

  <section class="section contact-section">
    <div class="section__inner contact-layout">
      <div class="contact-copy">
        <p class="section-kicker">A personal response</p>
        <h2>How can we help?</h2>
        <p>Use this form for a business introduction, event, tour, property enquiry, hire request or local recommendation.</p>
        <div class="contact-direct">
          <a href={contact.whatsapp} target="_blank" rel="noreferrer">
            <span>WhatsApp</span>
            <strong>{contact.phoneDisplay}</strong>
          </a>
          <a href={`mailto:${contact.email}`}>
            <span>Email</span>
            <strong>{contact.email}</strong>
          </a>
          <a href={contact.facebook} target="_blank" rel="noreferrer">
            <span>Community</span>
            <strong>First Contact Thailand on Facebook</strong>
          </a>
        </div>
      </div>

      <form class="contact-form" data-contact-form>
        <div class="form-row">
          <label>
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>
        <label>
          <span>What do you need help with?</span>
          <select name="topic">
            <option>Business introduction</option>
            <option>Community event</option>
            <option>Tour or local experience</option>
            <option>Property</option>
            <option>Hire or transport</option>
            <option>Local deal or recommendation</option>
            <option>Something else</option>
          </select>
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" rows="7" required></textarea>
        </label>
        <button class="button button--primary" type="submit">Prepare email</button>
        <p class="form-note">Submitting opens your email app with the message prepared. You can also contact us directly on WhatsApp.</p>
      </form>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-contact-form]');
    if (!form) return;

    const params = new URLSearchParams(window.location.search);
    const requestedTopic = params.get('topic');
    if (requestedTopic) {
      const select = form.querySelector('select[name="topic"]');
      const customOption = document.createElement('option');
      customOption.value = requestedTopic;
      customOption.textContent = requestedTopic;
      customOption.selected = true;
      select?.appendChild(customOption);
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const subject = `First Contact enquiry: ${data.get('topic')}`;
      const body = [
        `Name: ${data.get('name')}`,
        `Email: ${data.get('email')}`,
        `Topic: ${data.get('topic')}`,
        '',
        String(data.get('message') ?? ''),
      ].join('\n');
      window.location.href = `mailto:info@firstcontactthailand.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  })();
</script>

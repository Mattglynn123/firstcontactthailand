---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
---

<Layout title="About First Contact Thailand" description="Learn how First Contact Thailand connects trusted local businesses, communities and charitable causes." image="/assets/fct/PHOTO-2025-10-11-09-28-41-2.jpg">
  <PageHero
    eyebrow="Our community"
    title="About First Contact Thailand"
    text="A practical local network built around trusted connections, community participation and giving back."
    image="/assets/fct/PHOTO-2025-10-11-09-28-41-2.jpg"
    primaryLabel="Explore the network"
    primaryHref="/local-business-network/"
    secondaryLabel="Contact us"
    secondaryHref="/contact-link/"
  />

  <section class="section">
    <div class="section__inner split-section">
      <div class="split-section__media">
        <img src="/assets/fct/hero6-1024x542.jpg" alt="Koh Samui coastline" loading="lazy" decoding="async" />
      </div>
      <div class="split-section__copy">
        <p class="section-kicker">Founded in Koh Samui</p>
        <h2>Useful introductions with a community purpose</h2>
        <p>First Contact began in 2024 to help locals, expats and travellers find reliable services and genuine local connections without unnecessary guesswork.</p>
        <p>The network grew from more than 500 Koh Samui businesses and continues to expand across Thailand, connecting people with practical support in business, events, property, tours, hire and everyday local life.</p>
        <p>Supporting charities, Rotary clubs and community groups remains at the heart of the model.</p>
      </div>
    </div>
  </section>
</Layout>

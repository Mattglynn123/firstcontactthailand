---
import type { PastEventsPage as Page } from '../data/past-events';

interface Props { page: Page; }
const { page } = Astro.props;
---

<section class="reference-page regional-events past-events-page">
  <div class="reference-page__inner">
    <div class="archive-top-action">
      <a class="page-cta archive-top-action__cta" href={page.returnHref}>Return to upcoming events</a>
    </div>

    <header class="reference-page__heading">
      <h1>Past Events</h1>
    </header>

    {page.events.length ? (
      <div class="event-grid">
        {page.events.map((event) => (
          <article class="event-card">
            <a class="event-card__media" href={event.href ?? event.image} aria-label={`View ${event.title}`}>
              <img src={event.image} alt={event.title} loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/assets/fct/hero-community.jpg';" />
            </a>
            <div class="event-card__body">
              <p class="event-card__date">{event.date}</p>
              <h2>{event.title}</h2>
              <p>{event.text}</p>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h2>No previous events are listed for {page.location} yet</h2>
        <p>Return to the current events page for the latest local calendar.</p>
      </div>
    )}

    <div class="reference-page__actions regional-events__actions">
      <a class="page-cta" href={page.returnHref}>Return to upcoming events</a>
      <a class="page-cta page-cta--image" href={`/contact-link/?topic=${encodeURIComponent(`${page.location} community event`)}`}>Tell us about a community event</a>
    </div>
  </div>
</section>

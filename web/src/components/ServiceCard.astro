---
import type { ServiceCard as Card } from '../data/site';

interface Props {
  card: Card;
}

const { card } = Astro.props;
const href = card.href ?? `/contact-link/?topic=${encodeURIComponent(card.title)}`;
---

<article class="service-tile">
  {card.image && <img class="service-tile__image" src={card.image} alt={card.title} loading="lazy" decoding="async" />}
  <div class="service-tile__body">
    {card.meta && <p class="service-tile__meta">{card.meta}</p>}
    <h2>{card.title}</h2>
    <p>{card.text}</p>
    {card.action && <a class="service-tile__cta" href={href}>{card.action}</a>}
  </div>
</article>

---
interface Props {
  title: string;
  text: string;
  href: string;
  label: string;
}

const { title, text, href, label } = Astro.props;
---

<section class="cta-section">
  <div>
    <p class="eyebrow">Next step</p>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <a class="button primary" href={href}>{label}</a>
</section>

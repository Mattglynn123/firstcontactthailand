---
import { propertyAreas } from '../data/property-areas';
---

<section class="reference-page property-sales-reference">
  <div class="reference-page__inner">
    <header class="reference-page__heading">
      <h1>Property Sales</h1>
      <p>Choose an area to explore property opportunities with trusted local contacts.</p>
    </header>
    <div class="service-grid service-grid--3 property-sales-grid">
      {propertyAreas.map((area) => (
        <article class="service-tile">
          <img class="service-tile__image" src={area.image} alt={`Property in ${area.name}`} loading="lazy" decoding="async" />
          <div class="service-tile__body">
            <h2>{area.name}</h2>
            <p>{area.intro}</p>
            <a class="service-tile__cta" href={`/property-sales/${area.slug}/`}>View {area.name} property sales</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

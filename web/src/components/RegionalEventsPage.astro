---
import type { RegionalEventsPage as Page } from '../data/regional-events';

interface Props { page: Page; }
const { page } = Astro.props;
---

<section class="reference-page regional-events">
  <div class="reference-page__inner">
    <header class="reference-page__heading">
      <h1>Socialising in {page.location}</h1>
    </header>
    <h2 class="regional-events__title">Upcoming Events</h2>
    {page.events.length ? (
      <div class="event-grid">
        {page.events.map((event) => (
          <article class="event-card">
            <a class="event-card__media" href={event.href ?? `/contact-link/?topic=${encodeURIComponent(event.title)}`} aria-label={`Find out more about ${event.title}`}>
              <img src={event.image} alt={event.title} loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/assets/fct/hero-community.jpg';" />
            </a>
            <div class="event-card__body">
              <p
                class="event-card__date"
                data-weekly-day={event.weeklyDay}
                data-weekly-prefix={event.weeklyPrefix}
              >
                {event.date}
              </p>
              <h2>{event.title}</h2>
              <p>{event.text}</p>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h2>{page.emptyTitle ?? 'Events will be added here'}</h2>
        <p>Know about a community event in {page.location}? Send it to First Contact Thailand for review.</p>
      </div>
    )}
    <div class="reference-page__actions regional-events__actions">
      <a class="page-cta" href={`/past-events/${page.archiveSlug}/`}>Check out our previous events</a>
      <a class="page-cta page-cta--image" href={`/contact-link/?topic=${encodeURIComponent(`${page.location} community event`)}`}>Let us know if you have a community event coming up</a>
    </div>
  </div>
</section>

<script>
  (() => {
    const bangkokFormatter = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Bangkok',
      year: 'numeric',
      month: 'numeric',
      day: 'numeric',
    });
    const weekdayFormatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'UTC',
      weekday: 'long',
    });
    const monthFormatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'UTC',
      month: 'long',
    });
    const suffix = (day) => {
      const teen = day % 100;
      if (teen >= 11 && teen <= 13) return 'th';
      if (day % 10 === 1) return 'st';
      if (day % 10 === 2) return 'nd';
      if (day % 10 === 3) return 'rd';
      return 'th';
    };
    const todayInBangkok = () => {
      const parts = Object.fromEntries(
        bangkokFormatter.formatToParts(new Date()).map((part) => [part.type, part.value])
      );
      return new Date(Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day)));
    };

    document.querySelectorAll('[data-weekly-day]').forEach((element) => {
      const day = Number(element.getAttribute('data-weekly-day'));
      if (!Number.isInteger(day)) return;
      const today = todayInBangkok();
      const daysUntil = (day - today.getUTCDay() + 7) % 7;
      const nextDate = new Date(today);
      nextDate.setUTCDate(today.getUTCDate() + daysUntil);
      const dateLabel = `${weekdayFormatter.format(nextDate)} ${nextDate.getUTCDate()}${suffix(nextDate.getUTCDate())} ${monthFormatter.format(nextDate)}`;
      element.textContent = `${element.getAttribute('data-weekly-prefix') ?? ''}${dateLabel}`;
    });
  })();
</script>

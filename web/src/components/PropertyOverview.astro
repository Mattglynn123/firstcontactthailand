---
const services = [
  {
    label: 'Property Sales',
    text: 'Explore property opportunities by area and connect with trusted local sales contacts.',
    image: '/assets/fct/property-home.jpg',
    href: '/property-sales/',
  },
  {
    label: 'Property Management',
    text: 'Find practical support for rentals, maintenance, inspections and local owner services.',
    image: '/assets/fct/house-1-scaled.jpg',
    href: '/property-management/',
  },
  {
    label: 'Building Contractors',
    text: 'Connect with trusted contractors for construction, renovation and local project support.',
    image: '/assets/fct/property-building.jpg',
    href: '/building-contractors/',
  },
  {
    label: 'Buyers Agent',
    text: 'Get local search support, practical area guidance and trusted introductions before buying.',
    image: '/assets/fct/buyersagent.png',
    href: '/buyers-agent/',
  },
];
---

<section class="reference-page property-reference">
  <div class="reference-page__inner property-reference__inner">
    <header class="reference-page__heading">
      <h1>Property</h1>
      <p>Choose the property service you need.</p>
    </header>
    <div class="service-grid service-grid--4 property-overview-grid">
      {services.map((item) => (
        <article class="service-tile">
          <img class="service-tile__image" src={item.image} alt={item.label} loading="lazy" decoding="async" />
          <div class="service-tile__body">
            <h2>{item.label}</h2>
            <p>{item.text}</p>
            <a class="service-tile__cta" href={item.href}>Find out more</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

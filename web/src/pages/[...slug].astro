---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import MoveGuidePage from '../components/MoveGuidePage.astro';
import PageHero from '../components/PageHero.astro';
import RegionalEventsPage from '../components/RegionalEventsPage.astro';
import CharityRegionPage from '../components/CharityRegionPage.astro';
import CharityProgramPage from '../components/CharityProgramPage.astro';
import CompletedCharityProgramsPage from '../components/CompletedCharityProgramsPage.astro';
import MoveToThailandPage from '../components/MoveToThailandPage.astro';
import OtherToursPage from '../components/OtherToursPage.astro';
import TourGuidePage from '../components/TourGuidePage.astro';
import { regionalEvents } from '../data/regional-events';
import { charityPrograms, charityRegions, completedCharityPages } from '../data/charities';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  const programSlugs = new Set(charityPrograms.map((program) => program.slug));
  const explicitRoutes = new Set([
    'about',
    'about-us',
    'community-events',
    'contact-2',
    'contact-3',
    'contact-link',
    'health-fitness',
    'hire',
    'local-business-network',
    'local-deals',
    'past-events',
    'property',
    'real-estate',
    'tours-2',
  ]);

  const pagePaths = pages.filter((page) => !explicitRoutes.has(page.data.slug) && !programSlugs.has(page.data.slug)).map((page) => ({
    params: { slug: page.data.slug },
    props: { page },
  }));

  const programPaths = charityPrograms.map((charityProgram) => ({
    params: { slug: charityProgram.slug },
    props: { charityProgram },
  }));

  const completedCharityPaths = completedCharityPages.map((completedCharityPage) => ({
    params: { slug: completedCharityPage.slug },
    props: { completedCharityPage },
  }));

  return [...pagePaths, ...programPaths, ...completedCharityPaths];
}

const { page, charityProgram, completedCharityPage } = Astro.props;
let Content;
if (page) {
  const rendered = await render(page);
  Content = rendered.Content;
}
const rawBody = (page?.body ?? '').trim();
const isLegacyPlaceholder = /layouts\.siteorigin|Lorem ipsum|John Doe|\[\]\(#\)|\]\(#\)|live-website\.com|wp-content|wordpress\.com|<iframe|u003ciframe|Welcome to WordPress/i.test(rawBody);
const isRegionalPlaceholder = new Set([
  'moving-to-bangkok',
  'moving-to-chiang-mai',
  'moving-to-hua-hin',
  'moving-to-pattaya',
  'moving-to-phuket',
]).has(page?.data.slug);
const moveGuideCityBySlug = {
  'moving-to-bangkok': 'Bangkok',
  'moving-to-chiang-mai': 'Chiang Mai',
  'moving-to-hua-hin': 'Hua Hin',
  'moving-to-pattaya': 'Pattaya',
  'moving-to-phuket': 'Phuket',
};
const moveGuideCity = moveGuideCityBySlug[page?.data.slug];
const usesStandardFallback = rawBody.length < 80 || isLegacyPlaceholder || isRegionalPlaceholder;
const contentHasH1 = /^#\s+/m.test(rawBody);
const cleanTitle = (page?.data.title ?? charityProgram?.title ?? completedCharityPage?.title ?? 'First Contact Thailand')
  .replace(/&#038;/g, '&')
  .replace(/&#8211;/g, '-')
  .replace(/-/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const fallbackCopy = {
  'affiliate-marketing': 'Connect with trusted local partners for affiliate, referral, and practical online income opportunities in Thailand.',
  'airport-transfers': 'Arrange fair, reliable airport transfer support with trusted local drivers.',
  'bar-deals': 'Find local bar deals, happy hours, and social places without paying tourist prices.',
  'building-a-property-in-thailand': 'Connect with trusted building contractors and property support in Thailand.',
  'business-directory': 'Find trusted local businesses, services, and community contacts across Thailand.',
  'business-directory-2': 'Find trusted local businesses, services, and community contacts across Thailand.',
  'business-networking': 'Meet useful local business contacts, community members, and service providers.',
  'business-set-ups': 'Get connected with practical local support for setting up and running a business in Thailand.',
  'car-bike-hire': 'Find trusted local car and bike hire support with clear prices and practical help.',
  'carbikehire': 'Find trusted local car and bike hire support with clear prices and practical help.',
  'charities': 'Explore local charity programs and community projects supported through First Contact Thailand.',
  'charity': 'Explore local charity programs and community projects supported through First Contact Thailand.',
  'charity-work': 'Explore local charity programs and community projects supported through First Contact Thailand.',
  'co-working-spaces': 'Find practical co-working spaces and local work-friendly places across Thailand.',
  'crypto-education-business': 'Connect with local crypto education, online business, and digital opportunity support.',
  'day-trips': 'Plan local day trips with trusted drivers, boat operators, and local partners.',
  'fitness': 'Find local fitness, wellness, and community activity options in Thailand.',
  'food-drink-deals': 'Find local food and drink deals, trusted recommendations, and places locals actually use.',
  'food-drinks': 'Find local food and drink deals, trusted recommendations, and places locals actually use.',
  'graphic-design': 'Connect with trusted graphic design and creative support for your business or project.',
  'health-wellbeing': 'Find trusted health, wellbeing, fitness, and community wellness support.',
  'hire-group': 'Find trusted local hire services, transport, equipment, and practical support.',
  'insurance': 'Connect with trusted local insurance support for life in Thailand.',
  'jetski-hire': 'Find trusted local water activity and jetski hire support.',
  'koh-phangan': 'Find local contacts, events, services, and community support on Koh Phangan.',
  'koh-samui': 'Find local contacts, events, services, and community support on Koh Samui.',
  'learn-thai': 'Connect with local language learning, Thai lessons, and English teaching support.',
  'legal-advice': 'Connect with trusted local legal support and practical guidance in Thailand.',
  'marketing': 'Connect with trusted marketing, social media, and business promotion support.',
  'moving-to-bangkok': 'Start your move to Bangkok with practical local information and trusted introductions for the services you need.',
  'moving-to-chiang-mai': 'Start your move to Chiang Mai with practical local information and trusted introductions for the services you need.',
  'moving-to-hua-hin': 'Start your move to Hua Hin with practical local information and trusted introductions for the services you need.',
  'moving-to-pattaya': 'Start your move to Pattaya with practical local information and trusted introductions for the services you need.',
  'moving-to-phuket': 'Start your move to Phuket with practical local information and trusted introductions for the services you need.',
  'mens-health-wellness': 'Find local men\'s health, wellness, and support options.',
  'nannies': 'Find trusted local nanny and family support services.',
  'networking': 'Meet useful local contacts and community members through First Contact Thailand.',
  'online-jobs': 'Explore remote work, online jobs, and practical income opportunities.',
  'remote-online-work-opportunities': 'Explore remote work, online jobs, and practical income opportunities.',
  'restaurant-deals': 'Find local restaurant deals and trusted food recommendations.',
  'social-events': 'Find local social events, meetups, and community activities.',
  'social-events-2': 'Find local social events, meetups, and community activities.',
  'social-media-support': 'Connect with trusted social media support for your business or project.',
  'solar': 'Connect with local solar and practical home improvement support.',
  'vehicle-rental': 'Find trusted local vehicle rental support with clear prices and local backup.',
  'visas': 'Connect with trusted visa support and relocation guidance.',
  'water': 'Find trusted local water, drinking water, and home supply support.',
  'welcome-to-samui': 'Start with practical local contacts, services, and community support on Koh Samui.',
};
const currentSlug = page?.data.slug ?? charityProgram?.slug ?? completedCharityPage?.slug;
const fallbackDescription = fallbackCopy[currentSlug] ?? completedCharityPage?.intro ?? charityProgram?.text ?? `Connect with trusted local support for ${cleanTitle.toLowerCase()} in Thailand.`;
const fallbackHeroImage = (() => {
  const slug = currentSlug;
  if (/property|building|buyers/.test(slug)) return '/assets/fct/property-home.jpg';
  if (/tour|trip|jet|family/.test(slug)) return '/assets/fct/tours-day-trip.jpg';
  if (/hire|rental|transfer|car|bike|nann/.test(slug)) return '/assets/fct/hire-bike.jpg';
  if (/deal|food|drink|bar|restaurant/.test(slug)) return '/assets/fct/deals-drinks.jpg';
  if (/health|fitness|wellness|water/.test(slug)) return '/assets/fct/gym-scaled.jpg';
  if (/event|social/.test(slug)) return '/assets/fct/event-business-lunch.png';
  if (/charit|rotary|children|pink/.test(slug)) return '/assets/fct/hero-community.jpg';
  return '/assets/fct/hero-network.jpg';
})();
const eventPageSlugs = new Set([
  'bangkok-community-events',
  'chiang-mai-community-events',
  'community-events',
  'hua-hin-community-events',
  'koh-phangan-community-events',
  'krabi-community-events',
  'paint-night-event-registration-page',
  'pattaya-community-events',
  'phuket-community-events',
  'social-events',
  'social-events-2',
]);
const isEventPage = eventPageSlugs.has(currentSlug);
const tourDetailPageSlugs = new Set([
  'airport-transfers',
  'become-a-better-tour-guide',
  'day-trips',
  'family-activities',
  'jetski-hire',
  'other-tours',
  'tours',
  'tours-clean',
]);
const isTourDetailPage = tourDetailPageSlugs.has(currentSlug);
const hasLocalDealsBeachCta = currentSlug === 'local-deals';
const regionalEventPage = regionalEvents[currentSlug];
const charityRegionAliases: Record<string, keyof typeof charityRegions> = {
  'chiang-mai-charity-programs-2': 'chiang-mai-charity-programs',
};
const charityRegion = charityRegions[currentSlug] ?? charityRegions[charityRegionAliases[currentSlug]];
const isMoveGuide = currentSlug === 'move-to-thailand-guide' || currentSlug === 'moving-to-samui';
const isOtherTours = currentSlug === 'other-tours';
const isTourGuide = currentSlug === 'become-a-better-tour-guide';
---

<Layout title={`${cleanTitle} — First Contact Thailand`} description={fallbackDescription} image={fallbackHeroImage}>
  {charityProgram ? (
    <CharityProgramPage program={charityProgram} />
  ) : completedCharityPage ? (
    <CompletedCharityProgramsPage page={completedCharityPage} />
  ) : charityRegion ? (
    <CharityRegionPage page={charityRegion} />
  ) : regionalEventPage ? (
    <RegionalEventsPage page={regionalEventPage} />
  ) : isMoveGuide ? (
    <MoveToThailandPage />
  ) : isOtherTours ? (
    <OtherToursPage />
  ) : isTourGuide ? (
    <TourGuidePage />
  ) : moveGuideCity ? (
    <MoveGuidePage city={moveGuideCity} title={cleanTitle} text={fallbackDescription} image={fallbackHeroImage} />
  ) : usesStandardFallback ? (
    <>
      <PageHero
        eyebrow={isEventPage ? 'Community events' : 'Trusted local connections'}
        title={cleanTitle}
        text={fallbackDescription}
        image={fallbackHeroImage}
        primaryLabel={isEventPage ? 'Tell us about an event' : 'Ask for a local introduction'}
        primaryHref={`/contact-link/?topic=${encodeURIComponent(cleanTitle)}`}
        secondaryLabel={isEventPage ? 'See previous events' : 'Explore the network'}
        secondaryHref={isEventPage ? '/past-events/' : '/local-business-network/'}
        topActionLabel={isTourDetailPage ? 'Return to homepage' : undefined}
        topActionHref={isTourDetailPage ? '/' : undefined}
      />
      <section class="section">
        <div class="section__inner support-layout">
          <div class="support-layout__intro">
            <p class="section-kicker">First Contact Thailand</p>
            <h2>Practical help from trusted local contacts</h2>
            <p>Tell us what you need and where you are. We will help you find a suitable local route without outdated templates, duplicate sections or unreliable listings.</p>
          </div>
          <div class="support-points">
            <article>
              <span>01</span>
              <h3>Share what you need</h3>
              <p>Give us the service, location and timing so we can understand the request clearly.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Get a local introduction</h3>
              <p>We point you towards a relevant provider, event, service or community contact.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Support local communities</h3>
              <p>First Contact connections are built around fair local service and stronger communities.</p>
            </article>
            <article>
              <span>04</span>
              <h3>Keep the process simple</h3>
              <p>Use one clear contact point instead of searching through outdated or duplicated pages.</p>
            </article>
          </div>
        </div>
      </section>
    </>
  ) : (
    <article class={`content-page ${isEventPage ? 'event-page' : ''} prose prose-slate mx-auto max-w-3xl py-8`}>
      {isTourDetailPage && (
        <div class="archive-top-action">
          <a class="page-cta archive-top-action__cta" href="/">Return to homepage</a>
        </div>
      )}
      {!contentHasH1 && <h1>{cleanTitle}</h1>}
      {Content && <Content />}
      {hasLocalDealsBeachCta && (
        <div class="double-cta beach-only">
          <a class="beach-cta" href="/contact-link/?topic=Local%20Deals">Tell us about a local deal</a>
        </div>
      )}
      {isEventPage && (
        <div class="double-cta">
          <a href="/past-events/">Check out our previous events</a>
          <a class="beach-cta" href={`/contact-link/?topic=${encodeURIComponent(cleanTitle)}`}>Let us know if you have a community event coming up</a>
        </div>
      )}
    </article>
  )}
</Layout>

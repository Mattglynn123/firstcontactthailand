---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const pages = (await getCollection('pages', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="All pages — First Contact Thailand">
  <h1 class="mb-6 text-3xl font-bold">All migrated pages ({pages.length})</h1>
  <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
    {pages.map((p) => (
      <li>
        <a href={`/${p.data.slug}`} class="block rounded-lg border border-slate-200 p-3 hover:border-teal-500 hover:bg-teal-50">
          <span class="font-medium">{p.data.title || p.data.slug}</span>
          <span class="block text-xs text-slate-400">/{p.data.slug}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>

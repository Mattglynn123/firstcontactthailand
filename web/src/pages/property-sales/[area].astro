---
import Layout from '../../layouts/Layout.astro';
import PropertyListingsPage from '../../components/PropertyListingsPage.astro';
import { propertyAreas } from '../../data/property-areas';

export function getStaticPaths() {
  return propertyAreas.map((area) => ({ params: { area: area.slug }, props: { area } }));
}

const { area } = Astro.props;
---

<Layout title={`Property Sales in ${area.name} | First Contact Thailand`} description={`Current property listings for sale in ${area.name}.`} image={area.image}>
  <PropertyListingsPage area={area} />
</Layout>

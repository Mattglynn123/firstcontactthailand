---
const target = '/contact-link/?topic=Building%20Contractors';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Building Contractors | First Contact Thailand</title>
    <script is:inline define:vars={{ target }}>
      document.addEventListener('astro:page-load', () => {
        window.location.replace(target);
      });
    </script>
  </head>
  <body>
    <a href={target}>Continue to the enquiry form</a>
  </body>
</html>

---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContentCard from '../components/ContentCard.astro';
import CTASection from '../components/CTASection.astro';
import { homePage } from '../data/priorityPages';
---

<Layout title={homePage.seoTitle} description={homePage.description}>
  <PageHero
    eyebrow="Community first"
    title="First Contact Thailand"
    text="Trusted local connections for business services, events, tours, property, hire and local deals across Thailand."
    image={homePage.heroImage}
    primaryAction={{ label: 'Find Local Support', href: '/local-business-network/' }}
    secondaryAction={{ label: 'Contact Us', href: '/contact-link/' }}
  />

  <section class="content-section">
    <SectionHeading
      eyebrow="Launch MVP"
      title="Clear routes into the network"
      text="The first Astro release focuses on the pages people need most, rebuilt as clean responsive pages instead of imported WordPress layouts."
    />
    <div class="card-grid">
      {homePage.sections.map((section) => (
        <ContentCard
          card={{
            title: section.title,
            text: section.description,
            image: section.heroImage,
            href: `/${section.slug}/`,
            action: `Open ${section.title}`,
          }}
        />
      ))}
    </div>
  </section>

  <CTASection
    title="Need help finding the right person?"
    text="Tell us what you need and we will connect you with a trusted local partner or community contact."
    href="/contact-link/"
    label="Contact First Contact"
  />
</Layout>

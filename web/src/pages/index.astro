---
import Layout from '../layouts/Layout.astro';
import { contact, homeSections } from '../data/site';

const communityImages = [
  {
    src: '/assets/fct/past-event-nature-bar-day-party.jpeg',
    alt: 'First Contact Thailand community event at Nature Bar',
  },
  {
    src: '/assets/fct/past-event-paint-and-sip-3-may-4.jpeg',
    alt: 'First Contact Thailand paint and sip community event',
  },
  {
    src: '/assets/fct/past-event-beach-day-party-maenam-29-march.jpeg',
    alt: 'First Contact Thailand beach community event in Maenam',
  },
];
---

<Layout
  title="First Contact Thailand | Trusted Local Connections"
  description="First Contact Thailand connects locals, expats and visitors with trusted businesses, services, events and community support."
  image="/assets/fct/PHOTO-2025-10-11-09-28-41-2.jpg"
>
  <section class="home-hero" style="--home-hero-image: url('/assets/fct/PHOTO-2025-10-11-09-28-41-2.jpg')">
    <div class="home-hero__inner">
      <p class="eyebrow">Business network & community</p>
      <h1>First Contact Thailand</h1>
      <p>Trusted local connections for business, community and everyday life across Thailand.</p>
      <div class="home-hero__actions">
        <a class="button button--primary" href="/local-business-network/">Explore the network</a>
        <a class="button button--light" href="/contact-link/">Tell us what you need</a>
      </div>
    </div>
  </section>

  <section class="section home-intro">
    <div class="section__inner split-section">
      <div class="split-section__media">
        <img src="/assets/fct/hero6-1024x542.jpg" alt="Koh Samui coastline" loading="eager" decoding="async" />
      </div>
      <div class="split-section__copy">
        <p class="section-kicker">About us</p>
        <h2>Local knowledge. Trusted people. Stronger communities.</h2>
        <p>First Contact was founded in Koh Samui in 2024 to bring locals, expats and travellers together through reliable local businesses and useful community connections.</p>
        <p>Supporting charities, Rotary clubs and community groups remains central to how the network works. Members help generate local opportunities while giving back to causes that matter.</p>
        <a class="text-link" href="/local-business-network/">Discover the network <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="section section--ink how-it-works">
    <div class="section__inner">
      <div class="section-heading section-heading--light">
        <p class="section-kicker">How it works</p>
        <h2>One trusted starting point for local life in Thailand</h2>
        <p>Membership is free. Tell us what you need, and we use local knowledge to point you towards practical, reliable support.</p>
      </div>
      <ol class="steps-grid">
        <li><span>01</span><h3>Tell us what you need</h3><p>Share the service, location, dates or local question.</p></li>
        <li><span>02</span><h3>Get a trusted introduction</h3><p>We connect you with suitable contacts from the local network.</p></li>
        <li><span>03</span><h3>Support local communities</h3><p>The network creates local value while helping community causes.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="section__inner">
      <div class="section-heading">
        <p class="section-kicker">Explore First Contact</p>
        <h2>Practical connections, all in one place</h2>
        <p>Start with the area that best matches what you need.</p>
      </div>
      <div class="home-service-grid">
        {homeSections.map((item) => (
          <a class="home-service" href={item.href}>
            <img src={item.image} alt="" loading="lazy" decoding="async" />
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <span>Explore <span aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section events-band">
    <div class="section__inner events-band__inner">
      <div>
        <p class="section-kicker">Weekly connections</p>
        <h2>Community and business events</h2>
        <p>Meet people through business lunches, social gatherings, community activities and local events.</p>
      </div>
      <div class="events-band__actions">
        <a class="button button--primary" href="/community-events/">See community events</a>
        <a class="button button--outline" href="/contact-link/?topic=List%20a%20community%20event">List an event</a>
      </div>
    </div>
  </section>

  <section class="section community-gallery">
    <div class="section__inner">
      <div class="section-heading">
        <p class="section-kicker">Community in action</p>
        <h2>Real people, local events and shared experiences</h2>
      </div>
      <div class="community-gallery__grid">
        {communityImages.map((image) => <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />)}
      </div>
    </div>
  </section>

  <section class="section final-cta home-final-cta">
    <div class="section__inner final-cta__inner">
      <div>
        <p class="section-kicker">Start with a conversation</p>
        <h2>Not sure where to begin?</h2>
        <p>Tell us what you need and we will help you find the right local connection.</p>
      </div>
      <div class="button-group">
        <a class="button button--primary" href={contact.whatsapp} target="_blank" rel="noreferrer">Message on WhatsApp</a>
        <a class="button button--outline" href="/contact-link/">Contact First Contact</a>
      </div>
    </div>
  </section>
</Layout>

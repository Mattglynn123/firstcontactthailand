---
import Layout from '../layouts/Layout.astro';
---

<Layout title="First Contact Thailand — Business Network Community">
  <section class="py-16 text-center">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">
      Business Network <span class="text-teal-600">with Limitless Potential</span>
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
      Over 300+ local businesses in our network across Koh Samui &amp; Koh Phangan.
      Whatever service you need, we point you in the right direction.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/pages" class="rounded-lg bg-teal-600 px-6 py-3 font-semibold text-white hover:bg-teal-700">
        Browse the network
      </a>
      <a href="/contact-link" class="rounded-lg border border-slate-300 px-6 py-3 font-semibold hover:bg-slate-50">
        Contact us
      </a>
    </div>
  </section>
  <p class="text-center text-sm text-slate-400">
    🚧 New site under construction — content migrated from WordPress, redesign in progress.
  </p>
</Layout>

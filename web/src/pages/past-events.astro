---
import Layout from '../layouts/Layout.astro';
import PastEventsPage from '../components/PastEventsPage.astro';
import { pastEvents } from '../data/past-events';
---

<Layout title="Past Events | First Contact Thailand" description="Past First Contact Thailand community events by area." image="/assets/fct/beach-craft-market-nature-bar-maenam-20260530.jpeg">
  <PastEventsPage page={pastEvents.samui} />
</Layout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const area = new URLSearchParams(window.location.search).get('area');
    if (area && area !== 'samui') window.location.replace(`/past-events/${encodeURIComponent(area)}/`);
  });
</script>

---
const target = '/contact-link/?topic=Property%20Management';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Property Management | First Contact Thailand</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <a href={target}>Continue to the enquiry form</a>
  </body>
</html>
